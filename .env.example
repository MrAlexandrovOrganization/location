ADDR=:8080
LOCATION_DB_PASSWORD=strong_password_here

# Read-only PostgreSQL role used by the Grafana PostgreSQL datasource.
GRAFANA_DB_PASSWORD=grafana_ro_password

# Log level: debug|info|warn|error (default: info)
LOG_LEVEL=info

# SHA-256 hex of a random mobile bearer token. Empty disables mobile ingestion.
# Keep the actual token on the phone; never commit it or print it in logs.
MOBILE_TOKEN_SHA256=
